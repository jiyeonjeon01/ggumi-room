# Copy to .env (never commit .env) and fill in.

# Host port for local checks only; bound to 127.0.0.1, never to the LAN.
WEB_PORT=8080

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install command.
# Paste only the token (the long string after --token). Keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Later, with the api/db services:
# POSTGRES_DB=ggumiroom
# POSTGRES_USER=ggumiroom
# POSTGRES_PASSWORD=
