# Copy to .env (never commit .env) and fill in.

# Host port for local checks only; bound to 127.0.0.1, never to the LAN.
WEB_PORT=9021

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install command.
# Paste only the token (the long string after --token). Keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=

# API host port for local checks only (127.0.0.1).
API_PORT=9201

# PostgreSQL (db service, internal network only). Use a long random password,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=ggumiroom
POSTGRES_USER=ggumiroom
POSTGRES_PASSWORD=

# API settings (defaults shown).
# PUBLIC_BASE_URL=https://www.ggumiroom.com   # invite links + CSRF Origin check
# COOKIE_SECURE=true                          # keep true in production (HTTPS)
# ENABLE_DOCS=false                           # /api/docs; keep off in production

# Contact shown in the privacy policy (/privacy), e.g. an operator email. Built into the web
# image (rebuild web after changing). Empty: the policy points to the in-site report button.
VITE_PRIVACY_CONTACT=
